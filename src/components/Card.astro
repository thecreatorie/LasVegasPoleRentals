---
export interface Props {
  title: string;
  description?: string;
  href?: string;
  eyebrow?: string;
  variant?: 'default' | 'feature' | 'image';
}

const { title, description, href, eyebrow, variant = 'default' } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class={`card card--${variant}${href ? ' card--linked' : ''}`} href={href}>
  {eyebrow && <p class="card__eyebrow">{eyebrow}</p>}
  <slot name="media" />
  <h3 class="card__title">{title}</h3>
  {description && <p class="card__desc">{description}</p>}
  <slot />
</Tag>

<style>
  .card {
    position: relative;
    display: block;
    padding: var(--space-6);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    background-image: none;
    color: var(--color-text);
    overflow: hidden;
    isolation: isolate;
    transition: transform var(--duration-base) var(--ease-standard),
                box-shadow var(--duration-base) var(--ease-standard),
                border-color var(--duration-base) var(--ease-standard);
  }
  .card::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    background: var(--gradient-neon-sweep);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-standard);
    z-index: 1;
  }
  .card--linked:hover,
  .card--linked:focus-visible {
    transform: translateY(-4px);
    border-color: rgba(168, 85, 247, 0.4);
    box-shadow: var(--shadow-lg), 0 0 32px rgba(168, 85, 247, 0.18);
  }
  .card--linked:hover::after,
  .card--linked:focus-visible::after { transform: scaleX(1); }

  .card__eyebrow {
    margin: 0 0 var(--space-3) 0;
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-neon-cyan);
  }
  .card__title {
    margin: 0;
    font-size: var(--fs-xl);
  }
  .card__desc {
    margin: var(--space-3) 0 0 0;
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
  }

  /* Feature card — larger, more dramatic. Used for product/value props. */
  .card--feature {
    padding: var(--space-8);
  }
  .card--feature .card__title {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
  }

  /* Image card — full-bleed media, dark gradient at bottom for text legibility */
  .card--image {
    padding: 0;
    aspect-ratio: 4/5;
  }
  .card--image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-standard);
  }
  .card--image:hover :global(img) { transform: scale(1.06); }
  .card--image .card__title {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--space-12) var(--space-5) var(--space-5);
    background: linear-gradient(180deg, transparent, rgba(10, 10, 15, 0.9) 60%);
    color: #fff;
    z-index: 2;
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
    margin: 0;
  }
</style>
