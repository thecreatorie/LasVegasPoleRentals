---
/**
 * Wrapper for reveal-on-scroll. The IntersectionObserver lives in BaseLayout
 * and watches for any [data-reveal] or [data-reveal-stagger] element, so this
 * component is purely sugar — but it documents the intent.
 *
 * Use `stagger` to cascade direct children.
 */
export interface Props {
  as?: string;
  stagger?: boolean;
  class?: string;
}
const { as: Tag = 'div', stagger = false, class: className = '' } = Astro.props;
const dataAttr = stagger ? 'data-reveal-stagger' : 'data-reveal';
---

<Tag class={className} {...{ [dataAttr]: '' }}>
  <slot />
</Tag>
