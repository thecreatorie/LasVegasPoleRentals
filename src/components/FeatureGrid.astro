---
/**
 * Why-LVPR feature grid. Used on homepage and product page.
 */
export interface Props {
  items: Array<{ icon: string; title: string; body: string }>;
}
const { items } = Astro.props;

// Inline SVG icons (line, 1.5px stroke).
const icons: Record<string, string> = {
  bolt:     '<path stroke-linecap="round" stroke-linejoin="round" d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/>',
  shield:   '<path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  truck:    '<path stroke-linecap="round" stroke-linejoin="round" d="M1 3h15v13H1zM16 8h4l3 3v5h-7M5.5 21a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM18.5 21a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"/>',
  star:     '<path stroke-linecap="round" stroke-linejoin="round" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>',
  rotate:   '<path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 1 1-3-6.7M21 3v6h-6"/>',
  ruler:    '<path stroke-linecap="round" stroke-linejoin="round" d="M3 3h18v18H3zM7 3v4M11 3v6M15 3v4M19 3v6M3 7h4M3 11h6M3 15h4M3 19h6"/>',
  clock:    '<circle cx="12" cy="12" r="9"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2"/>',
  dollar:   '<path stroke-linecap="round" stroke-linejoin="round" d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
};
---

<ul class="feature-grid" data-reveal-stagger>
  {items.map((it) => (
    <li class="feature">
      <span class="feature__icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" set:html={icons[it.icon] ?? icons.star}></svg>
      </span>
      <h3 class="feature__title">{it.title}</h3>
      <p class="feature__body">{it.body}</p>
    </li>
  ))}
</ul>

<style>
  .feature-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 640px) { .feature-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .feature-grid { grid-template-columns: repeat(3, 1fr); } }

  .feature {
    padding: var(--space-6);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    transition: transform var(--duration-base) var(--ease-standard),
                border-color var(--duration-base) var(--ease-standard);
  }
  .feature:hover {
    transform: translateY(-3px);
    border-color: rgba(34, 211, 238, 0.4);
  }

  .feature__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background: rgba(168, 85, 247, 0.12);
    color: var(--color-neon-cyan);
    margin-bottom: var(--space-4);
  }
  .feature__title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: var(--fw-bold);
    color: var(--color-ink);
  }
  .feature__body {
    margin: 0;
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
  }
</style>
