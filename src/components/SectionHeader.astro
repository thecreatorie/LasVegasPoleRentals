---
export interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  /** Apply gradient sweep across the title. */
  gradient?: boolean;
}
const { eyebrow, title, description, align = 'left', gradient = false } = Astro.props;
---

<header class={`section-header section-header--${align}`} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class={gradient ? 'text-gradient' : ''}>{title}</h2>
  {description && <p class="section-header__desc">{description}</p>}
  <span class="section-header__underline" aria-hidden="true"></span>
</header>

<style>
  .section-header {
    margin-block: 0 var(--space-12);
    max-width: 64ch;
    position: relative;
  }
  .section-header--center {
    text-align: center;
    margin-inline: auto;
  }
  .section-header h2 {
    margin: 0;
    line-height: var(--lh-tight);
  }
  .section-header__desc {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--fs-lg);
    line-height: var(--lh-normal);
  }
  .section-header__underline {
    display: block;
    margin-top: var(--space-5);
    width: 0;
    height: 2px;
    background: var(--gradient-neon-sweep);
    transition: width var(--duration-story) var(--ease-standard) 200ms;
  }
  .section-header--center .section-header__underline {
    margin-inline: auto;
  }
  .section-header.is-visible .section-header__underline {
    width: 72px;
  }
</style>
