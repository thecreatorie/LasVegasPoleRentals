---
import PageLayout from '../layouts/PageLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import ServiceArea from '../components/ServiceArea.astro';
import { siteConfig } from '../site.config';
import { breadcrumbList } from '../lib/breadcrumbs';

// Formspree form ID — wired to the LVPR contact form.
// AJAX submission via @formspree/ajax (loaded in ContactForm.astro). Plain-POST
// fallback works automatically if JS is off.
const formspreeFormId = 'xqennkbb';

const contactFields = [
  { name: 'name',        label: 'Your name',          type: 'text' as const,     required: true,  autocomplete: 'name' },
  { name: 'phone',       label: 'Phone',              type: 'tel' as const,      required: true,  autocomplete: 'tel', placeholder: '702-555-0123' },
  { name: 'email',       label: 'Email',              type: 'email' as const,    required: true,  autocomplete: 'email' },
  { name: 'event_date',  label: 'Date needed',        type: 'date' as const,     required: false },
  { name: 'location',    label: 'Hotel / venue',      type: 'text' as const,     required: false, placeholder: 'e.g. Bellagio, MGM Grand suite, private home in Henderson' },
  { name: 'message',     label: 'Tell us about it',   type: 'textarea' as const, required: true,  placeholder: 'How many people? Ceiling height (if known)? Anything else we should plan for?' },
];

const contactSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contact Las Vegas Pole Rentals',
    url: `${siteConfig.url}/contact/`,
    about: { '@type': 'LocalBusiness', name: siteConfig.name, url: siteConfig.url, telephone: siteConfig.phone },
  },
  breadcrumbList([{ name: 'Contact', path: '/contact/' }]),
];
---

<PageLayout
  title="Get in Touch with LVPR | Rent a Stripper Pole in Las Vegas"
  description="Contact LVPR — call or text 702-205-1440 for same-day pole rentals in Las Vegas. Or send a message and we'll come back within a few hours."
  eyebrow="Contact"
  heading="Get in touch."
  intro="Call or text for same-day service. Or send a message — we usually come back within a few hours."
  schema={contactSchema}
>
  <!-- Phone + Email CTA -->
  <section class="contact-cta" data-reveal>
    <div class="container">
      <div class="contact-cta__grid">
        <div class="contact-cta__card">
          <p class="label">Phone</p>
          <p class="contact-cta__big">{siteConfig.phoneDisplay}</p>
          <div class="contact-cta__actions">
            <a href={siteConfig.phoneHref} class="contact-cta__btn contact-cta__btn--call">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
              Call
            </a>
            <a href={`sms:+17022051440?&body=${encodeURIComponent('Hi! I would like to rent a pole for an upcoming event.')}`} class="contact-cta__btn contact-cta__btn--text">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              Text
            </a>
          </div>
        </div>

        <div class="contact-cta__card">
          <p class="label">Email</p>
          <a href={`mailto:${siteConfig.email}?subject=${encodeURIComponent('Pole Rental Inquiry')}&body=${encodeURIComponent('Hi! I am interested in renting a pole for an upcoming event.\n\nDate needed:\nVenue/Hotel:\nNumber of guests:\n')}`} class="contact-cta__email">{siteConfig.email}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Form -->
  <section class="section-pad" data-reveal>
    <div class="container contact-form-wrap">
      <div>
        <p class="eyebrow">Or send a message</p>
        <h2>Tell us what you need.</h2>
        <p class="contact-form-wrap__sub">
          The more you tell us up front, the faster we can confirm your booking. Ceiling height, number of guests,
          and the venue are the most useful details.
        </p>
        <p class="contact-form-wrap__hint">
          <strong>Heads up:</strong> we don't book through the form — we'll text or email you back, and the rental is
          confirmed once we agree on the date and you're on our schedule.
        </p>
      </div>
      <ContactForm
        formId={formspreeFormId}
        fields={contactFields}
        submitLabel="Send to LVPR"
        subject="New pole rental inquiry"
      />
    </div>
  </section>

  <!-- Service area (replaces broken London Eye Google Map) -->
  <ServiceArea />
</PageLayout>

<style>
  .contact-cta { padding-block: var(--space-12) var(--space-8); }
  .contact-cta__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 640px) { .contact-cta__grid { grid-template-columns: 1fr 1fr; } }

  .contact-cta__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-8);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    color: var(--color-text);
    transition: border-color var(--duration-base) var(--ease-standard),
                box-shadow var(--duration-base) var(--ease-standard);
  }
  .contact-cta__card:hover {
    border-color: rgba(168, 85, 247, 0.5);
    box-shadow: var(--glow-purple);
  }
  .contact-cta__big {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.5rem + 2.5vw, 3rem);
    font-weight: var(--fw-bold);
    line-height: 1;
    color: var(--color-ink);
    letter-spacing: -0.02em;
  }
  .contact-cta__actions {
    display: flex;
    gap: var(--space-3);
  }
  .contact-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-full);
    font-weight: var(--fw-bold);
    font-size: var(--fs-sm);
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-spring),
                box-shadow var(--duration-fast) var(--ease-standard);
  }
  .contact-cta__btn:hover { transform: scale(1.04); }
  .contact-cta__btn--call {
    background: var(--gradient-button);
    color: #fff;
  }
  .contact-cta__btn--call:hover { box-shadow: var(--glow-purple); }
  .contact-cta__btn--text {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }
  .contact-cta__btn--text:hover { border-color: var(--color-neon-cyan); box-shadow: var(--glow-cyan); }
  .contact-cta__email {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    font-weight: var(--fw-bold);
    color: var(--color-ink);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .contact-cta__email:hover { color: var(--color-neon-cyan); }

  .contact-form-wrap {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: start;
  }
  @media (min-width: 900px) { .contact-form-wrap { grid-template-columns: 1fr 1.3fr; gap: var(--space-12); } }

  .contact-form-wrap h2 { margin: var(--space-2) 0 var(--space-5); }
  .contact-form-wrap__sub {
    color: var(--color-text-muted);
    font-size: var(--fs-lg);
    line-height: var(--lh-normal);
    margin: 0 0 var(--space-6);
  }
  .contact-form-wrap__hint {
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface);
    border-left: 3px solid var(--color-neon-cyan);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
    margin: 0;
  }
  .contact-form-wrap__hint strong { color: var(--color-ink); }
</style>
