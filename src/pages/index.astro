---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import PricingTable from '../components/PricingTable.astro';
import StatsBand from '../components/StatsBand.astro';
import Marquee from '../components/Marquee.astro';
import Testimonial from '../components/Testimonial.astro';
import Button from '../components/Button.astro';
import { Image } from 'astro:assets';
import { siteConfig } from '../site.config';
import { testimonials } from '../data/testimonials';

import poleHero from '../assets/images/pole1.jpg';
import pole2 from '../assets/images/pole2.jpg';
import pole3 from '../assets/images/pole3.jpg';
import pole4 from '../assets/images/pole4.jpg';
import pole5 from '../assets/images/pole5.jpg';
import canopyShoot from '../assets/images/canopy-shoot.jpg';
import morningBlend from '../assets/images/morning-blend.jpg';
import skatePole from '../assets/images/skate-pole.jpg';
import VideoLoop from '../components/VideoLoop.astro';

const reel = [
  { name: 'festival-stage', title: 'Festival main stage', note: 'Installed on a festival stage build' },
  { name: 'house-party', title: 'House party', note: 'DJ, lights and a pole in the living room' },
  { name: 'pool-party', title: 'Backyard pool party', note: 'Set up on the lawn, grip kit included' },
  { name: 'event-setup', title: 'Warehouse event', note: 'Two stages flanking the DJ booth' },
];

const gallery = [
  { src: poleHero, alt: 'Lupit pole stage with neon purple and cyan stage lighting' },
  { src: canopyShoot, alt: 'Dancer inverted on a rented pole under a lit canopy at an outdoor photo shoot' },
  { src: skatePole, alt: 'Dancer and skateboarder posing with a white pole stage in a Las Vegas wash' },
  { src: morningBlend, alt: 'Two instructors with a Lupit pole stage on the Las Vegas Morning Blend TV set' },
  { src: pole2, alt: 'Portable pole stage in a low-lit Las Vegas event space' },
  { src: pole3, alt: 'Lupit pole stage ready for an event' },
  { src: pole4, alt: 'Pole stage set up in a hotel room' },
  { src: pole5, alt: 'Pole rental setup for a private party' },
];

const features = [
  { icon: 'bolt',   title: 'Lupit Quick Lock™', body: 'Spin to static in under a second. No allen wrenches, no screws — just turn the locking ring at the base.' },
  { icon: 'truck',  title: 'We deliver & set up', body: 'Hotels, venues, studios, private homes. We bring the stage, set it up, and pick it up.' },
  { icon: 'clock',  title: '10-minute setup',    body: 'Pole stage assembled in 5–10 minutes. Looks great indoors or outdoors.' },
  { icon: 'shield', title: 'Insurance included', body: 'Every rental includes liability coverage. Peace of mind for you and your venue.' },
  { icon: 'ruler',  title: 'Three pole heights',    body: 'Choose between 8’4”, 9\' and 9’8”. We\'ll bring all three options. 5’3” diameter stage, 6 anti-slip legs.' },
  { icon: 'star',   title: 'Same-day service',   body: 'Need a pole today? No problem. First come, first served — call us and we’ll get you on the schedule.' },
];

const teacherSms = 'sms:+17022051440?&body=' + encodeURIComponent('Hi! I would like to rent a pole and hire a pole teacher.');

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Rent a Stripper Pole in Las Vegas | Las Vegas Pole Rentals',
  description: siteConfig.description,
  url: siteConfig.url + '/',
};
---

<BaseLayout
  title={`Rent a Stripper Pole in Las Vegas | ${siteConfig.name}`}
  description={siteConfig.description}
  schema={homeSchema}
>
  <Hero
    eyebrow={`Serving ${siteConfig.areaServed.slice(0, 3).join(', ')}`}
    title="pole rentals."
    titleHighlight="Las Vegas"
    subtitle="Portable Lupit pole stages, delivered and set up in your hotel room, venue, or studio. Same-day service. Rates from $250 for 24 hours."
    image={poleHero}
    imageAlt="Lupit pole stage with neon purple and cyan stage lighting"
    ctaLabel="Book a Pole"
    ctaHref="/rent-a-pole/"
    secondaryCtaLabel="See the gallery"
    secondaryCtaHref="/view-photos/"
    fullBleed={true}
  >
    <div slot="aside" class="hero-reel">
      <div class="hero-reel__frame">
        <VideoLoop name="hotel-suite" label="A Lupit pole stage set up in a high-rise hotel suite overlooking the Las Vegas Strip" eager />
        <span class="hero-reel__tag"><span class="live-dot" aria-hidden="true"></span> Delivered to your suite</span>
      </div>
      <figure class="hero-reel__photo">
        <Image src={skatePole} alt="" widths={[240, 360]} sizes="180px" loading="eager" />
      </figure>
    </div>
  </Hero>

  <div id="below-hero"></div>

  <About />

  <StatsBand items={[...siteConfig.stats]} />

  <!-- Video reel -->
  <section class="section-pad">
    <div class="container">
      <SectionHeader
        eyebrow="See it in action"
        title="Anywhere you can party, we can pole."
        description="Hotel suites, backyards, warehouses and festival stages — real LVPR setups around Las Vegas."
      />
    </div>
    <div class="container reel" data-reveal-stagger>
      {reel.map((r) => (
        <figure class="reel__item">
          <div class="reel__video"><VideoLoop name={r.name} label={`${r.title}: ${r.note}`} /></div>
          <figcaption><strong>{r.title}</strong><span>{r.note}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- Why LVPR -->
  <section class="section-pad">
    <div class="container">
      <SectionHeader
        eyebrow="Why LVPR"
        title="Rent a portable stripper pole."
        description="State-of-the-art Lupit stages. Real engineering, real setup, real service."
      />
      <FeatureGrid items={features} />
    </div>
  </section>

  <!-- Gallery preview -->
  <section class="section-pad" style="padding-top: 0;">
    <div class="container">
      <SectionHeader
        eyebrow="Gallery"
        title="Pole stages in the wild."
        description="Real setups in real Las Vegas spaces — hotel suites, event venues, private homes."
      />
    </div>
    <Marquee speed={42} ariaLabel="Photo gallery row 1">
      {gallery.map((img) => (
        <figure class="home-gallery-photo">
          <Image src={img.src} alt={img.alt} widths={[320, 480]} sizes="320px" />
        </figure>
      ))}
    </Marquee>
    <div style="height: var(--space-5)"></div>
    <Marquee speed={56} reverse={true} ariaLabel="Photo gallery row 2">
      {gallery.slice().reverse().map((img) => (
        <figure class="home-gallery-photo">
          <Image src={img.src} alt={img.alt} widths={[320, 480]} sizes="320px" />
        </figure>
      ))}
    </Marquee>
    <div class="container" style="text-align: center; margin-top: var(--space-10);">
      <Button href="/view-photos/" variant="secondary" size="lg">See full gallery</Button>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section-pad" style="padding-top: 0;">
    <div class="container">
      <SectionHeader eyebrow="Pricing" title="Rates that make sense." align="center" />
    </div>
    <PricingTable />
  </section>

  <!-- Hire a teacher -->
  <section class="section-pad" style="padding-top: 0;">
    <div class="container teacher" data-reveal>
      <figure class="teacher__media">
        <Image src={morningBlend} alt="Two pole instructors smiling beside a Lupit pole stage on the Las Vegas Morning Blend TV set" widths={[480, 720, 960]} sizes="(min-width: 900px) 460px, 100vw" />
        <span class="teacher__badge"><strong>$80</strong>/hr</span>
        <figcaption class="teacher__caption">As seen on <strong>Las Vegas Morning Blend</strong></figcaption>
      </figure>
      <div class="teacher__copy">
        <p class="eyebrow">Add a teacher</p>
        <h2>Don&rsquo;t know how to pole dance? <span class="text-gradient-hero">Hire a teacher!</span></h2>
        <p class="teacher__price">Only <strong>$80/hr</strong></p>
        <p class="teacher__body">
          Add a professional pole instructor to your rental. They come to you and get the whole
          group spinning, climbing and posing &mdash; no experience needed.
        </p>
        <div class="teacher__ctas">
          <Button href={teacherSms} variant="primary" size="lg">Text to book a teacher</Button>
          <Button href={siteConfig.phoneHref} variant="secondary" size="lg">Call {siteConfig.phoneDisplay}</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials grid -->
  <section class="section-pad" style="padding-top: 0;">
    <div class="container">
      <SectionHeader
        eyebrow="Reviews"
        title="Check out our reviews."
        description="From anniversaries to corporate trade shows — real Las Vegas customers."
      />
    </div>
    <div class="container testimonials-grid">
      {testimonials.slice(0, 4).map((t) => (
        <div class="home-testimonial-card">
          <Testimonial quote={t.quote.slice(0, 280) + (t.quote.length > 280 ? '…' : '')} name={t.name} location={t.location} rating={t.rating} />
        </div>
      ))}
    </div>
    <div class="container" style="text-align: center; margin-top: var(--space-10);">
      <Button href="/testimonials/" variant="secondary" size="lg">Read all reviews</Button>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="section-pad" style="padding-top: 0;">
    <div class="container home-cta">
      <p class="eyebrow" style="justify-content: center;">Ready?</p>
      <h2 class="hero-title text-gradient-hero">Need a pole today?</h2>
      <p class="home-cta__sub">
        Call or text <a href={siteConfig.phoneHref}>{siteConfig.phoneDisplay}</a> for same-day service —
        or send a quick message and we'll come back to you within a few hours.
      </p>
      <div class="home-cta__ctas">
        <Button href={siteConfig.phoneHref} variant="primary" size="xl">Call {siteConfig.phoneDisplay}</Button>
        <Button href="/contact/" variant="secondary" size="xl">Send a message</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .teacher {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
    padding: clamp(20px, 4vw, 48px);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-subtle);
    background:
      radial-gradient(ellipse at 100% 0%, color-mix(in oklab, var(--color-neon-magenta) 18%, transparent), transparent 60%),
      radial-gradient(ellipse at 0% 100%, color-mix(in oklab, var(--color-neon-cyan) 12%, transparent), transparent 60%),
      var(--color-surface);
  }
  @media (min-width: 900px) {
    .teacher { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: var(--space-12); }
  }
  .teacher__media { position: relative; margin: 0; max-width: 460px; justify-self: center; width: 100%; }
  .teacher__caption {
    position: absolute; left: 12px; bottom: 12px;
    padding: 6px 12px; border-radius: 999px;
    background: rgba(10, 10, 15, 0.75); backdrop-filter: blur(8px);
    color: var(--color-text-muted); font-size: var(--fs-xs);
    letter-spacing: 0.04em;
  }
  .teacher__caption strong { color: var(--color-text); }

  /* Hero video */
  .hero-reel { position: relative; width: min(340px, 82vw); margin-inline: auto; }
  .hero-reel__frame {
    position: relative; aspect-ratio: 9 / 16; border-radius: 28px; overflow: hidden;
    border: 2px solid color-mix(in oklab, var(--color-neon-magenta) 70%, white);
    box-shadow: 0 0 0 6px rgba(10, 10, 15, 0.6), var(--glow-purple), 0 30px 80px rgba(0, 0, 0, 0.6);
    transform: rotate(2.5deg);
  }
  .hero-reel__tag {
    position: absolute; left: 12px; bottom: 12px;
    display: inline-flex; align-items: center; gap: 8px;
    padding: 7px 12px; border-radius: 999px;
    background: rgba(10, 10, 15, 0.7); backdrop-filter: blur(8px);
    color: #fff; font-size: var(--fs-xs); font-weight: var(--fw-semibold); letter-spacing: 0.04em;
  }
  .live-dot { width: 8px; height: 8px; border-radius: 50%; background: #ff3b5c; box-shadow: 0 0 10px #ff3b5c; animation: live-pulse 1.6s ease-in-out infinite; }
  @keyframes live-pulse { 50% { opacity: 0.35; } }
  .hero-reel__photo {
    position: absolute; left: -22%; bottom: 8%; width: 46%; margin: 0;
    aspect-ratio: 3 / 4; border-radius: 16px; overflow: hidden;
    border: 2px solid var(--color-neon-cyan); box-shadow: var(--glow-cyan, 0 0 24px rgba(34, 211, 238, 0.5));
    transform: rotate(-6deg);
  }
  .hero-reel__photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 959px) { .hero-reel__photo { left: -8%; width: 40%; } }

  /* Video reel */
  .reel {
    display: grid; gap: var(--space-5);
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: var(--space-10);
  }
  .reel__item { margin: 0; }
  .reel__video {
    aspect-ratio: 9 / 16; border-radius: var(--radius-lg); overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    transition: border-color var(--duration-base) var(--ease-standard), box-shadow var(--duration-base) var(--ease-standard), transform var(--duration-base) var(--ease-standard);
  }
  .reel__item:hover .reel__video { border-color: var(--color-neon-purple); box-shadow: var(--glow-purple); transform: translateY(-4px); }
  .reel__item figcaption { display: grid; gap: 2px; margin-top: var(--space-3); }
  .reel__item figcaption strong { font-family: var(--font-display); font-size: var(--fs-lg); color: var(--color-text); }
  .reel__item figcaption span { color: var(--color-text-muted); font-size: var(--fs-sm); }
  @media (max-width: 900px) {
    .reel {
      grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 62%;
      overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: var(--space-3);
      scrollbar-width: none;
    }
    .reel::-webkit-scrollbar { display: none; }
    .reel__item { scroll-snap-align: start; }
  }
  .teacher__media :global(img) {
    width: 100%; height: auto; display: block;
    border-radius: var(--radius-lg);
    box-shadow: var(--glow-purple);
  }
  .teacher__badge {
    position: absolute; right: -10px; top: -14px;
    padding: 10px 16px; border-radius: 999px;
    background: var(--gradient-button); color: #fff;
    font-size: var(--fs-sm); box-shadow: var(--glow-purple);
    transform: rotate(6deg);
  }
  .teacher__badge strong { font-family: var(--font-display); font-size: var(--fs-2xl); line-height: 1; }
  .teacher__copy h2 { margin: var(--space-2) 0 var(--space-3); }
  .teacher__price { font-size: var(--fs-xl); color: var(--color-text); margin: 0 0 var(--space-3); }
  .teacher__price strong { color: var(--color-neon-cyan); }
  .teacher__body { color: var(--color-text-muted); max-width: 46ch; margin: 0 0 var(--space-6); }
  .teacher__ctas { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  .home-gallery-photo {
    width: 320px;
    aspect-ratio: 4/3;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
  }
  .home-gallery-photo :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform var(--duration-base) var(--ease-standard);
  }
  .home-gallery-photo:hover :global(img) { transform: scale(1.05); }

  .home-testimonial-card {
    width: 100%;
  }

  .testimonials-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
    margin-top: var(--space-8);
  }
  @media (min-width: 768px) {
    .testimonials-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .home-cta { text-align: center; max-width: 720px; }
  .home-cta__sub {
    margin: var(--space-6) 0 var(--space-8);
    font-size: var(--fs-xl);
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
  }
  .home-cta__sub a { font-weight: var(--fw-bold); }
  .home-cta__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
  }
</style>
