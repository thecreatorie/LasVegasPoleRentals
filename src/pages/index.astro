---
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../components/About.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import PricingTable from '../components/PricingTable.astro';
import StatsBand from '../components/StatsBand.astro';
import Marquee from '../components/Marquee.astro';
import Testimonial from '../components/Testimonial.astro';
import Button from '../components/Button.astro';
import { siteConfig } from '../site.config';
import { testimonials } from '../data/testimonials';
import { cloudinaryUrl, cloudinarySrcset, images } from '../data/media';

const features = [
  { icon: 'bolt',   title: 'Lupit Quick Lock™', body: 'Spin to static in under a second. No allen wrenches, no screws — just turn the locking ring at the base.' },
  { icon: 'truck',  title: 'We deliver & set up', body: 'Hotels, venues, studios, private homes. We bring the stage, set it up, and pick it up.' },
  { icon: 'clock',  title: '10-minute setup',    body: 'Pole stage assembled in 5–10 minutes. Looks great indoors or outdoors.' },
  { icon: 'shield', title: 'Insurance included', body: 'Every rental includes liability coverage. Peace of mind for you and your venue.' },
  { icon: 'ruler',  title: 'Three pole heights',    body: 'Choose between 8’4″, 9’ and 9’8″. We’ll bring all three options. 5’3″ diameter stage, 6 anti-slip legs.' },
  { icon: 'star',   title: 'Same-day service',   body: 'Need a pole today? No problem. First come, first served — call us and we’ll get you on the schedule.' },
];

const teacherSms = 'sms:+17022051440?&body=' + encodeURIComponent('Hi! I would like to rent a pole and hire a pole teacher.');

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Rent a Stripper Pole in Las Vegas | Las Vegas Pole Rentals',
  description: siteConfig.description,
  url: siteConfig.url + '/',
};

const venueShowcase = [
  { title: 'Hotel Suites',    desc: 'Penthouses, suites & high-rises', publicId: 'Photo_Jul_11_2024_11_09_06_PM', alt: 'Pole stage in a hotel room with Las Vegas Strip lights through the window' },
  { title: 'Private Parties',  desc: 'Bachelorettes, birthdays & more', publicId: 'Photo_May_03_2024_5_18_30_PM', alt: 'Las Vegas bachelorette party suite with pink balloons, disco ball, and pole' },
  { title: 'Event Venues',    desc: 'Clubs, restaurants & banquets',   publicId: 'Photo_Mar_08_2024_4_43_36_PM', alt: 'Pole stage set up in a restaurant banquet hall for a private event' },
  { title: 'Outdoor & Pool',  desc: 'Backyards, rooftops & poolside',  publicId: 'Photo_Jun_28_2026_9_57_36_AM', alt: 'Pole stage set up poolside in a Las Vegas backyard' },
];

const marqueeRow1 = [
  'Photo_Jul_03_2024_4_26_07_PM',
  'Photo_Jun_26_2026_6_29_45_PM',
  'Photo_Mar_08_2024_4_43_36_PM',
  'Photo_Jun_28_2026_9_57_36_AM',
  'Photo_Mar_24_2026_5_23_08_PM',
  'Photo_Sep_16_2022_1_44_53_PM',
  'Photo_Oct_21_2026_7_33_15_PM',
  'Photo_Jul_23_2025_9_55_18_PM',
];

const marqueeRow2 = [
  'Photo_Mar_13_2025_6_25_19_PM',
  'Photo_May_04_2024_7_16_23_PM',
  'Photo_Sep_08_2023_1_23_52_PM',
  'Photo_Nov_30_2023_6_25_04_PM',
  'Photo_Mar_16_2024_7_28_06_AM',
  'Photo_Jan_24_2026_6_10_30_PM',
  'Photo_May_11_2021_12_07_48_PM',
  'TASTE_34',
];

function altFor(publicId: string) {
  return images.find((i) => i.publicId === publicId)?.alt ?? '';
}
---

<BaseLayout
  title={`Rent a Stripper Pole in Las Vegas | ${siteConfig.name}`}
  description={siteConfig.description}
  schema={homeSchema}
  preloadImage={cloudinaryUrl('Photo_Mar_16_2024_7_28_06_AM', { width: 1280 })}
>
  <!-- Hero -->
  <section class="hero hero--full">
    <div class="hero__media" aria-hidden="true">
      <img
        src={cloudinaryUrl('Photo_Mar_16_2024_7_28_06_AM', { width: 1920 })}
        srcset={cloudinarySrcset('Photo_Mar_16_2024_7_28_06_AM', [768, 1280, 1920, 2400])}
        sizes="100vw"
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="hero__overlay" aria-hidden="true"></div>
    <div class="hero__spot" aria-hidden="true"></div>
    <div class="ambient-orb ambient-orb--purple" aria-hidden="true"></div>
    <div class="ambient-orb ambient-orb--magenta" aria-hidden="true"></div>

    <div class="container hero__inner hero__inner--split">
      <div class="hero__copy">
        <p class="eyebrow hero__eyebrow">Serving Las Vegas, Henderson, Summerlin</p>
        <h1 class="hero-title">
          <span class="text-gradient-hero">Las Vegas</span> pole rentals.
        </h1>
        <p class="hero__sub">
          Portable Lupit pole stages, delivered and set up in your hotel room, venue, or studio. Same-day service. Rates from $250 for 24&nbsp;hours.
        </p>
        <div class="hero__ctas">
          <Button href="/rent-a-pole/" variant="primary" size="lg">Book a Pole</Button>
          <Button href="/view-photos/" variant="secondary" size="lg">See the gallery</Button>
        </div>
        <a href={siteConfig.phoneHref} class="hero__phone">
          <span>or text/call</span>
          <strong>{siteConfig.phoneDisplay}</strong>
        </a>
      </div>

      <div class="hero__aside">
        <div class="hero-card hero-card--primary">
          <img
            src={cloudinaryUrl('Photo_Jul_23_2025_9_55_18_PM', { width: 480, height: 640, crop: 'fill', gravity: 'auto' })}
            srcset={`${cloudinaryUrl('Photo_Jul_23_2025_9_55_18_PM', { width: 320, height: 427, crop: 'fill', gravity: 'auto' })} 320w, ${cloudinaryUrl('Photo_Jul_23_2025_9_55_18_PM', { width: 480, height: 640, crop: 'fill', gravity: 'auto' })} 480w`}
            sizes="280px"
            width="480"
            height="640"
            alt="Pole performance at an elegant venue with pink and purple lighting"
            loading="eager"
            decoding="async"
          />
          <span class="hero-card__tag"><span class="live-dot" aria-hidden="true"></span> Delivered to your suite</span>
        </div>
        <div class="hero-card hero-card--secondary">
          <img
            src={cloudinaryUrl('Photo_Mar_24_2026_5_23_08_PM', { width: 320, height: 400, crop: 'fill', gravity: 'auto' })}
            sizes="140px"
            width="320"
            height="400"
            alt="Performer doing an inverted trick on a rooftop with the Las Vegas Sphere visible"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </div>

    <a href="#below-hero" class="hero__scroll" aria-label="Scroll for more">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m0 0l-6-6m6 6l6-6"/>
      </svg>
    </a>
  </section>

  <div id="below-hero"></div>

  <About />

  <StatsBand items={[...siteConfig.stats]} />

  <!-- Where We Set Up -->
  <section class="section-pad">
    <div class="container">
      <SectionHeader
        eyebrow="Where We Set Up"
        title="Any venue. Any event."
        description="Hotel suites, backyards, nightclubs, restaurants, pool decks &mdash; we bring the stage and handle everything."
      />
    </div>
    <div class="container venue-grid" data-reveal-stagger>
      {venueShowcase.map((v) => (
        <a href="/view-photos/" class="venue-card">
          <img
            src={cloudinaryUrl(v.publicId, { width: 400, height: 533, crop: 'fill', gravity: 'auto' })}
            srcset={`${cloudinaryUrl(v.publicId, { width: 300, height: 400, crop: 'fill', gravity: 'auto' })} 300w, ${cloudinaryUrl(v.publicId, { width: 400, height: 533, crop: 'fill', gravity: 'auto' })} 400w, ${cloudinaryUrl(v.publicId, { width: 600, height: 800, crop: 'fill', gravity: 'auto' })} 600w`}
            sizes="(min-width: 900px) 25vw, (min-width: 640px) 50vw, 100vw"
            width="400"
            height="533"
            alt={v.alt}
            loading="lazy"
            decoding="async"
          />
          <div class="venue-card__content">
            <h3>{v.title}</h3>
            <p>{v.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Why LVPR -->
  <section class="section-pad">
    <div class="container">
      <SectionHeader
        eyebrow="Why LVPR"
        title="Rent a portable stripper pole."
        description="State-of-the-art Lupit stages. Real engineering, real setup, real service."
      />
      <FeatureGrid items={features} />
    </div>
  </section>

  <!-- Gallery preview -->
  <section class="section-pad" style="padding-top: 0;">
    <div class="container">
      <SectionHeader
        eyebrow="Gallery"
        title="Pole stages in the wild."
        description="Real setups in real Las Vegas spaces &mdash; hotel suites, event venues, private homes."
      />
    </div>
    <Marquee speed={42} ariaLabel="Photo gallery row 1">
      {marqueeRow1.map((id) => (
        <figure class="home-gallery-photo">
          <img
            src={`https://res.cloudinary.com/wb2a64ho/image/upload/h_360,c_scale,q_auto,f_auto/${id}.jpg`}
            alt={altFor(id)}
            loading="lazy"
            decoding="async"
          />
        </figure>
      ))}
    </Marquee>
    <div style="height: var(--space-5)"></div>
    <Marquee speed={56} reverse={true} ariaLabel="Photo gallery row 2">
      {marqueeRow2.map((id) => (
        <figure class="home-gallery-photo">
          <img
            src={`https://res.cloudinary.com/wb2a64ho/image/upload/h_360,c_scale,q_auto,f_auto/${id}.jpg`}
            alt={altFor(id)}
            loading="lazy"
            decoding="async"
          />
        </figure>
      ))}
    </Marquee>
    <div class="container" style="text-align: center; margin-top: var(--space-10);">
      <Button href="/view-photos/" variant="secondary" size="lg">See full gallery</Button>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section-pad" style="padding-top: 0;">
    <div class="container">
      <SectionHeader eyebrow="Pricing" title="Rates that make sense." align="center" />
    </div>
    <PricingTable />
  </section>

  <!-- Hire a teacher -->
  <section class="section-pad" style="padding-top: 0;">
    <div class="container teacher" data-reveal>
      <figure class="teacher__media">
        <img
          src={cloudinaryUrl('Photo_Apr_08_2025_8_53_30_AM', { width: 720, height: 960, crop: 'fill', gravity: 'auto' })}
          srcset={`${cloudinaryUrl('Photo_Apr_08_2025_8_53_30_AM', { width: 480, height: 640, crop: 'fill', gravity: 'auto' })} 480w, ${cloudinaryUrl('Photo_Apr_08_2025_8_53_30_AM', { width: 720, height: 960, crop: 'fill', gravity: 'auto' })} 720w, ${cloudinaryUrl('Photo_Apr_08_2025_8_53_30_AM', { width: 960, height: 1280, crop: 'fill', gravity: 'auto' })} 960w`}
          sizes="(min-width: 900px) 460px, 100vw"
          width="720"
          height="960"
          alt="Fawnia Mondey on the Las Vegas Morning Blend TV show"
          loading="lazy"
          decoding="async"
        />
        <span class="teacher__badge"><strong>$80</strong>/hr</span>
        <figcaption class="teacher__caption">As seen on <strong>Las Vegas Morning Blend</strong></figcaption>
      </figure>
      <div class="teacher__copy">
        <p class="eyebrow">Add a teacher</p>
        <h2>Don&rsquo;t know how to pole dance? <span class="text-gradient-hero">Hire a teacher!</span></h2>
        <p class="teacher__price">Only <strong>$80/hr</strong></p>
        <p class="teacher__body">
          Add a professional pole instructor to your rental. They come to you and get the whole
          group spinning, climbing and posing &mdash; no experience needed.
        </p>
        <div class="teacher__ctas">
          <Button href={teacherSms} variant="primary" size="lg">Text to book a teacher</Button>
          <Button href={siteConfig.phoneHref} variant="secondary" size="lg">Call {siteConfig.phoneDisplay}</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials grid -->
  <section class="section-pad" style="padding-top: 0;">
    <div class="container">
      <SectionHeader
        eyebrow="Reviews"
        title="Check out our reviews."
        description="From anniversaries to corporate trade shows &mdash; real Las Vegas customers."
      />
    </div>
    <div class="container testimonials-grid">
      {testimonials.slice(0, 4).map((t) => (
        <div class="home-testimonial-card">
          <Testimonial quote={t.quote.slice(0, 280) + (t.quote.length > 280 ? '…' : '')} name={t.name} location={t.location} rating={t.rating} />
        </div>
      ))}
    </div>
    <div class="container" style="text-align: center; margin-top: var(--space-10);">
      <Button href="/testimonials/" variant="secondary" size="lg">Read all reviews</Button>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="section-pad" style="padding-top: 0;">
    <div class="container home-cta">
      <p class="eyebrow" style="justify-content: center;">Ready?</p>
      <h2 class="hero-title text-gradient-hero">Need a pole today?</h2>
      <p class="home-cta__sub">
        Call or text <a href={siteConfig.phoneHref}>{siteConfig.phoneDisplay}</a> for same-day service &mdash;
        or send a quick message and we&rsquo;ll come back to you within a few hours.
      </p>
      <div class="home-cta__ctas">
        <Button href={siteConfig.phoneHref} variant="primary" size="xl">Call {siteConfig.phoneDisplay}</Button>
        <Button href="/contact/" variant="secondary" size="xl">Send a message</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ────────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-bg);
    padding-block: var(--space-section);
    min-height: 60vh;
    display: flex;
    align-items: center;
  }
  .hero--full {
    min-height: 100vh;
    padding-block: var(--space-24) var(--space-16);
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.08);
    filter: saturate(1.15) contrast(1.05) brightness(0.7);
    will-change: transform;
    animation: hero-pan 12s ease-in-out infinite alternate;
  }
  @keyframes hero-pan {
    from { transform: scale(1.08) translate3d(-1%, -1%, 0); }
    to   { transform: scale(1.12) translate3d(1%, 1%, 0); }
  }
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(180deg, rgba(10, 10, 15, 0.35) 0%, rgba(10, 10, 15, 0.8) 70%, rgba(10, 10, 15, 1) 100%),
      var(--gradient-stage-lights);
    pointer-events: none;
  }
  .hero__spot {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--gradient-spotlight);
    pointer-events: none;
    mix-blend-mode: screen;
  }
  .ambient-orb {
    position: absolute;
    width: 480px;
    height: 480px;
    border-radius: 9999px;
    filter: blur(80px);
    z-index: 1;
    pointer-events: none;
    opacity: 0.45;
    will-change: transform;
  }
  .ambient-orb--purple {
    background: var(--color-neon-purple);
    top: -120px;
    left: -120px;
    animation: orb-drift 18s ease-in-out infinite alternate;
  }
  .ambient-orb--magenta {
    background: var(--color-neon-magenta);
    bottom: -160px;
    right: -120px;
    animation: orb-drift 22s ease-in-out infinite alternate-reverse;
  }
  @keyframes orb-drift {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(8%, -6%, 0); }
  }
  .hero__inner {
    position: relative;
    z-index: 3;
    max-width: 900px;
  }
  .hero__inner--split {
    max-width: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero__inner--split { grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); }
  }
  .hero__eyebrow { color: var(--color-neon-cyan); }
  .hero__eyebrow::before { background: var(--color-neon-cyan); }
  .hero__sub {
    margin: var(--space-6) 0 var(--space-8);
    font-size: var(--fs-xl);
    color: var(--color-text-muted);
    max-width: 56ch;
    line-height: var(--lh-normal);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .hero__phone {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-top: var(--space-8);
    color: var(--color-text-muted);
    text-decoration: none;
    background: none;
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
  }
  .hero__phone strong {
    font-family: var(--font-display);
    font-size: var(--fs-3xl);
    color: var(--color-ink);
    text-transform: none;
    letter-spacing: 0;
    transition: text-shadow var(--duration-base) var(--ease-standard);
  }
  .hero__phone:hover strong,
  .hero__phone:focus-visible strong { text-shadow: var(--glow-cyan); color: var(--color-neon-cyan); }
  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: var(--space-6);
    transform: translateX(-50%);
    z-index: 3;
    color: var(--color-text-muted);
    background: none;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    animation: scroll-bob 2s ease-in-out infinite;
  }
  .hero__scroll:hover { color: var(--color-ink); }
  @keyframes scroll-bob {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%      { transform: translateX(-50%) translateY(6px); }
  }

  /* ── Hero aside: floating cards ─────────────────────────────────────── */
  .hero__aside {
    position: relative;
    width: min(340px, 82vw);
    margin-inline: auto;
  }
  .hero-card--primary {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: 28px;
    overflow: hidden;
    border: 2px solid color-mix(in oklab, var(--color-neon-magenta) 70%, white);
    box-shadow: 0 0 0 6px rgba(10, 10, 15, 0.6), var(--glow-purple), 0 30px 80px rgba(0, 0, 0, 0.6);
    transform: rotate(2.5deg);
  }
  .hero-card--primary img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-card__tag {
    position: absolute;
    left: 12px;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border-radius: 999px;
    background: rgba(10, 10, 15, 0.7);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.04em;
  }
  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff3b5c;
    box-shadow: 0 0 10px #ff3b5c;
    animation: live-pulse 1.6s ease-in-out infinite;
  }
  @keyframes live-pulse { 50% { opacity: 0.35; } }
  .hero-card--secondary {
    position: absolute;
    left: -22%;
    bottom: 8%;
    width: 46%;
    margin: 0;
    aspect-ratio: 3 / 4;
    border-radius: 16px;
    overflow: hidden;
    border: 2px solid var(--color-neon-cyan);
    box-shadow: var(--glow-cyan);
    transform: rotate(-6deg);
  }
  .hero-card--secondary img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 959px) {
    .hero-card--secondary { left: -8%; width: 40%; }
  }

  /* ── Venue showcase grid ────────────────────────────────────────────── */
  .venue-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    margin-top: var(--space-10);
  }
  @media (min-width: 640px) {
    .venue-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 900px) {
    .venue-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .venue-card {
    position: relative;
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 3 / 4;
    text-decoration: none;
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    transition: transform var(--duration-base) var(--ease-standard),
                box-shadow var(--duration-base) var(--ease-standard);
  }
  .venue-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg), 0 0 32px rgba(168, 85, 247, 0.25);
  }
  .venue-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-standard);
  }
  .venue-card:hover img { transform: scale(1.05); }
  .venue-card__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-5) var(--space-6);
    background: linear-gradient(to top, rgba(10, 10, 15, 0.88) 0%, rgba(10, 10, 15, 0.4) 60%, transparent 100%);
  }
  .venue-card h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    color: #fff;
    line-height: var(--lh-tight);
  }
  .venue-card p {
    margin: var(--space-1) 0 0;
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  /* ── Teacher ────────────────────────────────────────────────────────── */
  .teacher {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
    padding: clamp(20px, 4vw, 48px);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-subtle);
    background:
      radial-gradient(ellipse at 100% 0%, color-mix(in oklab, var(--color-neon-magenta) 18%, transparent), transparent 60%),
      radial-gradient(ellipse at 0% 100%, color-mix(in oklab, var(--color-neon-cyan) 12%, transparent), transparent 60%),
      var(--color-surface);
  }
  @media (min-width: 900px) {
    .teacher { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: var(--space-12); }
  }
  .teacher__media { position: relative; margin: 0; max-width: 460px; justify-self: center; width: 100%; }
  .teacher__media img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-lg);
    box-shadow: var(--glow-purple);
