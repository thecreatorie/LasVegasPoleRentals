---
import PageLayout from '../layouts/PageLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import PricingTable from '../components/PricingTable.astro';
import Button from '../components/Button.astro';
import { siteConfig } from '../site.config';
import { breadcrumbList } from '../lib/breadcrumbs';
import { cloudinaryUrl, cloudinarySrcset } from '../data/media';

const specs = [
  { icon: 'ruler',  title: '8’4″, 9’ or 9’8″ poles',  body: 'Measure your ceiling and we’ll bring the right height for your space.' },
  { icon: 'rotate', title: 'Static or spin',       body: 'Lupit Quick Lock™ — change modes mid-performance with a turn of the locking ring. No tools.' },
  { icon: 'shield', title: '180 lb weight limit',  body: 'Built to safely hold up to 180 lbs (80 kg). Long-leg option adds stability for heavier performers.' },
  { icon: 'ruler',  title: '5’3″ stage diameter',  body: 'Stage needs ~5’10″ clear space. Six legs with anti-slip surfaces, rigid construction.' },
  { icon: 'clock',  title: '5–10 minute setup',    body: 'Our technician handles assembly and teardown. You don’t lift a thing.' },
  { icon: 'star',   title: '45 mm steel pole',     body: 'Stainless steel and chrome options available, both silver, visually identical. Tell us if you have a metal allergy.' },
];

const showcaseImages = [
  { publicId: 'Photo_Oct_21_2026_8_28_37_PM', alt: 'Portable pole in a luxury mansion living room with crystal chandeliers' },
  { publicId: 'Photo_May_04_2024_7_16_23_PM', alt: 'Bachelorette party suite with pink balloon arch and pole stage' },
  { publicId: 'Photo_Oct_21_2026_8_19_22_PM', alt: 'Pole stage by a luxury pool with blue LED lighting at night' },
  { publicId: 'Photo_Jan_25_2024_5_43_14_AM', alt: 'Pole stage at a Las Vegas nightclub venue with professional lighting' },
];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Portable Lupit Pole Stage Rental',
  description:
    'Rent a Lupit portable pole dance stage in Las Vegas. Delivered, set up, and picked up. Spin/static, 8’4″, 9’ or 9’8″ heights, 5’3″ stage diameter, 180 lb weight limit.',
  brand: { '@type': 'Brand', name: 'Lupit Pole' },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'USD',
    price: '250',
    availability: 'https://schema.org/InStock',
    url: `${siteConfig.url}/rent-a-pole/`,
    priceValidUntil: '2027-12-31',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5',
    reviewCount: '5',
  },
};

const pageSchema = [
  productSchema,
  breadcrumbList([{ name: 'Rent a Pole', path: '/rent-a-pole/' }]),
];
---

<PageLayout
  title="Rent a Pole | Portable Stage Poles for Rent in Las Vegas"
  description="Las Vegas Pole Rentals delivers portable Lupit pole stages with professional setup and teardown. 24-hour rentals from $250. Same-day service available."
  eyebrow="Rent a pole"
  heading="Portable stage poles, delivered."
  intro="State-of-the-art Lupit pole stages — same-day service across Las Vegas, Henderson, and Summerlin. Spin or static, set up in 10 minutes."
  schema={pageSchema}
>
  <!-- Phone-first CTA strip -->
  <section class="phone-strip" data-reveal>
    <div class="container phone-strip__inner">
      <div>
        <p class="label">Ready right now?</p>
        <p class="phone-strip__phone">
          <a href={siteConfig.phoneHref}>{siteConfig.phoneDisplay}</a>
        </p>
      </div>
      <div class="phone-strip__buttons">
        <Button href={siteConfig.phoneHref} variant="primary" size="lg">Call</Button>
        <Button href={siteConfig.smsHref}   variant="secondary" size="lg">Text</Button>
      </div>
    </div>
  </section>

  <!-- Why LVPR / Specs -->
  <section class="section-pad">
    <div class="container">
      <SectionHeader
        eyebrow="Why Lupit"
        title="A pole built for performance."
        description="The Lupit Pole Quick Lock™ pushes the boundaries of pole technology. Spin to static in under a second — no allen wrenches, no screws, just a simple turn of the locking ring."
      />
      <FeatureGrid items={specs} />
    </div>
  </section>

  <!-- Photo proof -->
  <section class="section-pad" style="padding-top: 0;" data-reveal>
    <div class="container product-proof">
      <figure>
        <img
          src={cloudinaryUrl('Photo_Sep_16_2022_1_44_53_PM', { width: 768, crop: 'fill', gravity: 'auto' })}
          srcset={cloudinarySrcset('Photo_Sep_16_2022_1_44_53_PM', [480, 768, 1024])}
          sizes="(min-width: 768px) 50vw, 100vw"
          width="768"
          height="576"
          alt="Pole stage set up in an elegant boutique hotel suite"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <figure>
        <img
          src={cloudinaryUrl('Photo_Mar_08_2024_4_43_36_PM', { width: 768, crop: 'fill', gravity: 'auto' })}
          srcset={cloudinarySrcset('Photo_Mar_08_2024_4_43_36_PM', [480, 768, 1024])}
          sizes="(min-width: 768px) 50vw, 100vw"
          width="768"
          height="576"
          alt="Pole stage set up in a restaurant banquet hall for a private event"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <!-- Real Setups showcase -->
  <section class="section-pad" style="padding-top: 0;">
    <div class="container">
      <SectionHeader
        eyebrow="Real setups"
        title="See where we deliver."
        description="Mansions, bachelorette suites, poolside at night, nightclub stages — we set up everywhere."
      />
      <div class="showcase" data-reveal-stagger>
        {showcaseImages.map((img) => (
          <figure class="showcase__item">
            <img
              src={cloudinaryUrl(img.publicId, { width: 480, height: 640, crop: 'fill', gravity: 'auto' })}
              srcset={`${cloudinaryUrl(img.publicId, { width: 320, height: 427, crop: 'fill', gravity: 'auto' })} 320w, ${cloudinaryUrl(img.publicId, { width: 480, height: 640, crop: 'fill', gravity: 'auto' })} 480w`}
              sizes="(min-width: 900px) 25vw, 65vw"
              width="480"
              height="640"
              alt={img.alt}
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section-pad" style="padding-top: 0;">
    <div class="container">
      <SectionHeader eyebrow="Pricing" title="Rent a pole." align="center" />
    </div>
    <PricingTable />
  </section>

  <!-- Final CTA -->
  <section class="section-pad" style="padding-top: 0;">
    <div class="container final-cta">
      <h2 class="hero-title text-gradient-hero">Book a pole.</h2>
      <p>
        Call or text <strong><a href={siteConfig.phoneHref}>{siteConfig.phoneDisplay}</a></strong> to lock in your rental.
        First come, first serve. 50% deposit to reserve. Balance due on day of setup. Advance booking recommended.
      </p>
      <div class="final-cta__buttons">
        <Button href={siteConfig.phoneHref} variant="primary" size="xl">Call {siteConfig.phoneDisplay}</Button>
        <Button href="/contact/" variant="secondary" size="xl">Send a message</Button>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .phone-strip {
    padding-block: var(--space-8);
    background: var(--color-surface);
    border-block: 1px solid var(--color-border-subtle);
  }
  .phone-strip__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: center;
    text-align: center;
  }
  @media (min-width: 768px) {
    .phone-strip__inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
  .phone-strip__phone {
    margin: var(--space-1) 0 0 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.5rem + 2.5vw, 3rem);
    font-weight: var(--fw-bold);
    line-height: 1;
  }
  .phone-strip__phone a {
    color: var(--color-ink);
    text-decoration: none;
    background: none;
    transition: color var(--duration-base) var(--ease-standard);
  }
  .phone-strip__phone a:hover { color: var(--color-neon-cyan); text-shadow: var(--glow-cyan); }
  .phone-strip__buttons {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
  }

  .product-proof {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }
  @media (min-width: 768px) { .product-proof { grid-template-columns: 1fr 1fr; } }
  .product-proof figure {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4/3;
    background: var(--color-surface);
  }
  .product-proof img { width: 100%; height: 100%; object-fit: cover; }

  .showcase {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: var(--space-8);
  }
  .showcase__item {
    margin: 0;
    aspect-ratio: 3/4;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    position: relative;
  }
  .showcase__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-base) var(--ease-standard);
  }
  .showcase__item:hover img { transform: scale(1.05); }
  @media (max-width: 900px) {
    .showcase {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 65%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .showcase::-webkit-scrollbar { display: none; }
    .showcase__item { scroll-snap-align: start; }
  }

  .final-cta { text-align: center; max-width: 720px; }
  .final-cta p {
    font-size: var(--fs-xl);
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
    margin: var(--space-6) 0 var(--space-8);
  }
  .final-cta__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
  }
</style>
