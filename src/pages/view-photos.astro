---
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/Button.astro';
import { siteConfig } from '../site.config';
import { breadcrumbList } from '../lib/breadcrumbs';
import { cloudinaryUrl, cloudinarySrcset, images } from '../data/media';
import type { MediaItem } from '../data/media';

const seen = new Set<string>();
const allImages: MediaItem[] = [];
const sorted = [...images.filter(i => i.featured), ...images.filter(i => !i.featured)];
for (const img of sorted) {
  if (!seen.has(img.publicId)) {
    seen.add(img.publicId);
    allImages.push(img);
  }
}

const INITIAL_COUNT = 18;

const galleryPageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ImageGallery',
    name: 'Las Vegas Pole Rentals — Gallery',
    description: 'Photos of portable Lupit pole stages set up across Las Vegas venues, hotels, and private spaces.',
    url: `${siteConfig.url}/view-photos/`,
  },
  breadcrumbList([{ name: 'Gallery', path: '/view-photos/' }]),
];
---

<PageLayout
  title="View our Gallery | Portable Stripper Pole Rentals | Las Vegas"
  description="See our portable Lupit pole stages in real Las Vegas venues — hotel suites, event spaces, private homes. The same stage we'll bring to you."
  eyebrow="Gallery"
  heading="Pole stages in the wild."
  intro="Hotel suites, event venues, private homes, rooftops, pool parties — anywhere in the Las Vegas Valley. All photos are real LVPR setups."
  schema={galleryPageSchema}
>
  <section class="section-pad">
    <div class="container">
      <ul class="gallery" id="gallery">
        {allImages.map((img, i) => (
          <li class={`gallery__item${i >= INITIAL_COUNT ? ' gallery__item--hidden' : ''}`}>
            <figure>
              <img
                src={cloudinaryUrl(img.publicId, { width: 768 })}
                srcset={cloudinarySrcset(img.publicId, [480, 768, 1280])}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                alt={img.alt}
                loading={i < 6 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </figure>
          </li>
        ))}
      </ul>

      <div class="gallery-load-more" id="load-more-wrap">
        <button class="load-more-btn" id="load-more-btn" type="button">
          Load More Photos
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <span class="gallery-count" id="gallery-count"></span>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-pad" style="padding-top: 0;">
    <div class="container gallery-cta">
      <h2 class="text-gradient">Want to see one in your space?</h2>
      <p>Call or text <a href={siteConfig.phoneHref}>{siteConfig.phoneDisplay}</a> &mdash; we'll talk through your ideas, your event, and get you the right pole for the job.</p>
      <div class="gallery-cta__buttons">
        <Button href="/rent-a-pole/" variant="primary" size="lg">Book a Pole</Button>
        <Button href={siteConfig.phoneHref} variant="secondary" size="lg">Call us</Button>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .gallery {
    list-style: none;
    padding: 0;
    margin: 0;
    columns: 1;
    column-gap: var(--space-4);
  }
  @media (min-width: 640px) { .gallery { columns: 2; } }
  @media (min-width: 1024px) { .gallery { columns: 3; } }

  .gallery__item {
    break-inside: avoid;
    margin-bottom: var(--space-4);
  }
  .gallery__item--hidden { display: none; }

  .gallery__item figure {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    position: relative;
    transition: transform var(--duration-base) var(--ease-standard),
                box-shadow var(--duration-base) var(--ease-standard);
  }
  .gallery__item figure img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform var(--duration-slow) var(--ease-standard);
    filter: saturate(1.1) contrast(1.03);
  }
  .gallery__item figure:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg), 0 0 32px rgba(168, 85, 247, 0.25);
  }
  .gallery__item figure:hover img {
    transform: scale(1.06);
  }

  .gallery-load-more {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-10);
  }
  .load-more-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--gradient-button);
    color: #fff;
    padding: var(--space-4) var(--space-8);
    border: none;
    border-radius: var(--radius-full);
    font-family: inherit;
    font-size: var(--fs-base);
    font-weight: var(--fw-semibold);
    cursor: pointer;
    transition: transform var(--duration-fast) var(--ease-standard),
                box-shadow var(--duration-fast) var(--ease-standard);
  }
  .load-more-btn:hover,
  .load-more-btn:focus-visible {
    transform: translateY(-2px);
    box-shadow: var(--glow-purple);
  }
  .gallery-count {
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  .gallery-cta { text-align: center; max-width: 640px; }
  .gallery-cta h2 { margin: 0; }
  .gallery-cta p {
    margin: var(--space-5) 0 var(--space-8);
    font-size: var(--fs-xl);
    color: var(--color-text-muted);
  }
  .gallery-cta__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
  }
</style>

<script>
  const gallery = document.getElementById('gallery');
  const btn = document.getElementById('load-more-btn');
  const wrap = document.getElementById('load-more-wrap');
  const countEl = document.getElementById('gallery-count');

  if (gallery && btn && wrap && countEl) {
    const hidden = gallery.querySelectorAll('.gallery__item--hidden');
    const total = gallery.querySelectorAll('.gallery__item').length;
    const visible = total - hidden.length;

    if (hidden.length === 0) {
      wrap.style.display = 'none';
    } else {
      countEl.textContent = `Showing ${visible} of ${total} photos`;
    }

    btn.addEventListener('click', () => {
      hidden.forEach((el) => el.classList.remove('gallery__item--hidden'));
      wrap.style.display = 'none';
    });
  }
</script>
